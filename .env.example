# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# OpenAI Compatible Provider configuration
OPENAI_COMPATIBLE_PROVIDER_NAME=openaiCompatible
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=****

# Optional JSON objects encoded as strings
# OPENAI_COMPATIBLE_HEADERS_JSON={"HTTP-Referer":"https://chatbox.example.com","X-App-Name":"Chatbox"}
# OPENAI_COMPATIBLE_QUERY_PARAMS_JSON={"api-version":"2024-10-01"}
OPENAI_COMPATIBLE_INCLUDE_USAGE=true
OPENAI_COMPATIBLE_SUPPORTS_STRUCTURED_OUTPUTS=true

# Model registry configuration
# MODEL_LIST must be a JSON array string. See specs/openai-compatible-provider/model-list.schema.json
MODEL_LIST=[{"id":"gpt-4o-mini","name":"GPT-4o Mini","provider":"openai","description":"Fast general model","capabilities":{"tools":true,"vision":true,"reasoning":false,"structuredOutputs":true}},{"id":"deepseek-chat","name":"DeepSeek Chat","provider":"deepseek","description":"General chat model","capabilities":{"tools":true,"vision":false,"reasoning":false,"structuredOutputs":true}},{"id":"deepseek-reasoner","name":"DeepSeek Reasoner","provider":"deepseek","description":"Reasoning model","capabilities":{"tools":false,"vision":false,"reasoning":true,"structuredOutputs":false},"providerOptions":{"reasoningEffort":"high"}}]
DEFAULT_CHAT_MODEL=gpt-4o-mini
TITLE_MODEL_ID=gpt-4o-mini

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****
